// sensory_map.jsonc — the seeker's senses into the circuit's sensory neurons,
// in the worm's format (examples/worm): every channel a named source through
// a pipeline of typed ops into a drive, a neuron of circuit.json. The sources
// are what observation/observation.mjs makes of the infrared, per tick of the
// motion stream (50 ms): an event is 1 on the tick it happened, else 0.
// Ops: gain k; rate tauMs, events per second, smoothed; clamp lo hi; mul by
// another source. The `ir` block is what the observation layer knows of the
// ladder and the receivers (docs/bolt-reference.md section 7, communication.ts).
{
  "ir": {
    // channel -> ladder and strength; a frame names its ladder and level
    "channels": { "0": ["long", 2], "1": ["long", 4], "2": ["long", 8], "3": ["long", 16],
                  "4": ["short", 1], "5": ["short", 2], "6": ["short", 4] },
    // receivers at the corners, front left, front right, back right, back left, deg off the nose
    "corners": { "FL": -45, "FR": 45, "BR": 135, "BL": -135 },
    // the sender's beat: one frame per 200.44 ms, the notify 45 ms after the frame;
    // a read lands only while the frame is in the air, 7.5 ms (behavior/beat.ts)
    "beatMs": 200.44, "learnFrom": 10,
    // over the bridge a read lands at a 40 ms lead (utils/read-timing.mjs, 2026-11-06: 3 of 15,
    // none at 20, 4 of 15 at 45 and 55 turning in place); two reads span that
    "volley": { "leadMs": 56, "reads": 2, "stepMs": 8 },
    // the carrier: the weakest level heard at least `minFrames` times in `windowMs`;
    // the level that is just arriving has an edge, nose or tail (recipes.md)
    "carrier": { "windowMs": 3000, "minFrames": 2 },
    // near: the long ladder's weakest level heard in `minFrames` of the last
    // `windowMs` asks for the short ladder; nothing of the short one in `lostMs` asks back
    "near": { "windowMs": 3500, "minFrames": 3, "lostMs": 3000 },
    // after the frames change ladder, the closeness is not compared for this long
    "settleMs": 3000
  },

  "channels": [
    // a read that landed: the corners that heard the frame, unless all four
    // (the sender on top, or a level heard all round) or two opposite ones
    { "drive": "IR_FL", "source": "corner.FL", "pipeline": [] },
    { "drive": "IR_FR", "source": "corner.FR", "pipeline": [] },
    { "drive": "IR_BR", "source": "corner.BR", "pipeline": [] },
    { "drive": "IR_BL", "source": "corner.BL", "pipeline": [] },

    // a frame of the carrier: the sender within the lobe, ahead or behind
    { "drive": "IR_AX", "source": "frame.carrier", "pipeline": [] },

    // the gradient, a klinokinesis cue: while driving ahead, a weaker level
    // starting to arrive says the sender is ahead, the carrier fading says behind
    { "drive": "IR_APPROACH", "source": "carrier.down", "pipeline": [ { "op": "mul", "by": "self.forward" } ] },
    { "drive": "IR_RECEDE",   "source": "carrier.up",   "pipeline": [ { "op": "mul", "by": "self.forward" } ] },

    // the gradient, the worm's way: closeness, log2(32 / strength) summed per
    // second over the frames heard, against its own mean over 4 s; rising while
    // driving ahead says ahead, falling says behind. Its noise is about 2 per s,
    // so only what stands out of it counts.
    { "drive": "IR_APPROACH", "source": "frame.closeness", "pipeline": [ { "op": "rate", "tauMs": 1500 }, { "op": "adapt", "tauMs": 4000 },
        { "op": "mul", "by": "self.forward" }, { "op": "mul", "by": "ladder.settled" }, { "op": "sub", "k": 1.5 }, { "op": "gain", "k": 0.15 }, { "op": "clamp", "lo": 0, "hi": 1 } ] },
    { "drive": "IR_RECEDE", "source": "frame.closeness", "pipeline": [ { "op": "rate", "tauMs": 1500 }, { "op": "adapt", "tauMs": 4000 }, { "op": "gain", "k": -1 },
        { "op": "mul", "by": "self.forward" }, { "op": "mul", "by": "ladder.settled" }, { "op": "sub", "k": 1.5 }, { "op": "gain", "k": 0.15 }, { "op": "clamp", "lo": 0, "hi": 1 } ] },

    // anything of the ladder: the sender is in range at all; frames per second
    { "drive": "IR_ANY", "source": "frame.any", "pipeline": [ { "op": "rate", "tauMs": 3000 } ] },

    // the ladder's state, held by the observation layer with its hysteresis
    { "drive": "IR_NEAR", "source": "ladder.near", "pipeline": [] }
  ]
}
