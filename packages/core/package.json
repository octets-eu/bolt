{
  "name": "@bolt/core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sphero Bolt driver: protocol, queue, sensors, actuators. No DOM, no Bluetooth.",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
