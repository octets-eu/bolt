{
  "name": "bolt",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Sphero Bolt workspace: browser app, driver packages, seeker",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/browser",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview --workspace apps/browser",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0"
  }
}
